# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files. .env.example is committed on purpose; everything real is not.
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Playwright browsers / audit output
.audit/
.audit-*.txt
.shots/

# Temp deploy bundle
.deploy-payload.json

.vercel

# Local email render previews
.email-preview/

# Ad-hoc probe scripts. These end up holding credentials while debugging, and one of
# them was committed to a PUBLIC repo with the /leads password in it. Never again.
*-probe.mjs
*-e2e.mjs
leads-e2e.mjs

# Agent working directory. Holds session state and local settings, and is exactly the kind
# of thing a `git add -A` sweeps into a PUBLIC repo without anyone reading it first.
.claude/

# Private listening audio is NOT in this repo and NOT in public/ any more. It lives in the
# private `listen` bucket in Supabase Storage, because anything under public/ is world
# readable and is only on production for as long as somebody deploys from the machine
# holding it. See lib/listen-audio.ts.
