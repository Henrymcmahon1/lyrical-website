STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_SINGLE=
STRIPE_PRICE_FAN=
STRIPE_PRICE_SUPERFAN=
# /investors gate. Separate namespace from DEMO_PASSWORD and ADMIN_PASSWORD.
INVESTOR_PASSWORD=

# Door-2 copyright check (see docs/bots/v3/copyright-research.md). Not set anywhere yet: Henry
# has no ACRCloud trial as of 22 Sep, so lib/copyright.ts has no network client to configure.
