NEXT_PUBLIC_SITE_URL=http://localhost:3000
GATE_SECRET=
# Who gets the notification. Comma separated for more than one; whitespace is trimmed.
ENQUIRY_TO_EMAIL=jordan@lyricalglobal.com,henry@lyricalglobal.com
# Must be on a domain verified in Resend. The moment this stops being an @resend.dev
# address, the enquirer confirmation email switches itself on. See lib/enquiry-email.ts.
ENQUIRY_FROM_EMAIL=onboarding@resend.dev
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=

# Stripe (test keys on omega, live only at promotion). Bot A's scripts/stripe-setup.ts prints the price ids.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_SINGLE=
STRIPE_PRICE_FAN=
STRIPE_PRICE_SUPERFAN=
# /investors gate. Separate namespace from DEMO_PASSWORD and ADMIN_PASSWORD.
INVESTOR_PASSWORD=

# /investors placeholders (Bot 3, 2026-09-22). All three render nothing until set; no code
# change is needed to turn one on.
# YouTube UNLISTED (not private, not public) video id. The embed uses youtube-nocookie.com.
INVESTOR_VIDEO_ID=
# Path to the pitch deck PDF inside a PRIVATE Supabase Storage bucket. Signed for 4 hours,
# same pattern as the Coffey audio and /listen.
INVESTOR_DECK_PATH=
# Defaults to "investors" (private bucket) when unset.
INVESTOR_DECK_BUCKET=

# Coffey Anderson before/after, embedded as a slot inside the home audience section
# (S02bAudience). Both paths must be set for the player to render; the bucket defaults to
# "listen".
COFFEY_ORIGINAL_PATH=
COFFEY_COVER_PATH=
COFFEY_BUCKET=
